# Build-time choice: local (browser SQLite) or server (Node + remote clients).
VITE_DEPLOYMENT=local

# Server-only settings; do not prefix secrets with VITE_.
DATA_DIR=./data
SERVER_ADMIN_USERNAME=admin
# Required only when initializing the first login. Use at least 12 characters.
SERVER_ADMIN_PASSWORD=
# Public URL, particularly when behind a reverse proxy.
ORIGIN=http://localhost:3000
