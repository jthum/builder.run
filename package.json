{
  "name": "builder.run",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:server": "VITE_DEPLOYMENT=server vp build && vp pack",
    "setup:server": "node build/setup.mjs",
    "start": "node build/index.js",
    "preview": "vp preview",
    "prepare": "vp config && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vp test",
    "test": "npm run test:unit -- --run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "test:server": "node scripts/server-smoke.mjs && node scripts/server-workflow.mjs",
    "test:server:workflow": "node scripts/server-workflow.mjs",
    "build:spacefast": "node scripts/build-spacefast-zero.mjs",
    "deploy:spacefast": "node scripts/deploy-spacefast.mjs",
    "check:spacefast": "svelte-check --tsconfig examples/spacefast-zero/tsconfig.json",
    "build:spacefast-browser": "node scripts/build-spacefast-browser.mjs",
    "test:spacefast-browser": "node scripts/build-spacefast-browser.mjs && node scripts/spacefast-browser-smoke.mjs"
  },
  "dependencies": {
    "@jthum/framework": "github:jthum/framework#86a6430606a248333459c29662bf86a8d2a65d14",
    "@jthum/framework-http": "github:jthum/framework#86a6430606a248333459c29662bf86a8d2a65d14&path:packages/http",
    "@jthum/framework-sqlite-browser": "github:jthum/framework#86a6430606a248333459c29662bf86a8d2a65d14&path:packages/sqlite/browser",
    "@jthum/yair": "github:jthum/framework#86a6430606a248333459c29662bf86a8d2a65d14&path:packages/inference/yair/core",
    "@jthum/yair-openai": "github:jthum/framework#86a6430606a248333459c29662bf86a8d2a65d14&path:packages/inference/yair/providers/openai",
    "nanoid": "^6.0.1",
    "pluralize": "^8.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.46.0",
    "@noble/hashes": "^2.4.0",
    "@spacefast/common": "0.8.0",
    "@spacefast/zero": "0.8.0",
    "@spacefast/zero-compile": "0.8.0",
    "@sveltejs/adapter-node": "6.0.0-next.15",
    "@sveltejs/adapter-static": "^4.0.0-next.4",
    "@sveltejs/kit": "^3.0.0-next.30",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.4.0",
    "@types/pluralize": "^0.0.33",
    "@types/ungap__structured-clone": "^1.2.0",
    "@ungap/structured-clone": "^1.4.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "puppeteer-core": "^25.9.0",
    "shadcn-svelte": "^1.5.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "webmcp-types": "^0.1.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
