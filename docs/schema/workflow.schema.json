{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://builder.run/schema/workflow.json",
  "title": "Builder.run workflow",
  "type": "object",
  "required": ["key", "label", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-Za-z]{16}$" },
    "key": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "meta": { "type": "object" },
    "description": { "type": "string" },
    "enabled": { "type": "boolean", "default": true },
    "priority": { "type": "integer", "default": 0 },
    "input": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/input" }
    },
    "trigger": { "$ref": "#/$defs/trigger" },
    "expose": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["ui", "agent"] }
    },
    "steps": { "$ref": "#/$defs/steps" }
  },
  "additionalProperties": false,
  "$defs": {
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": ["record"],
          "properties": {
            "record": { "type": "string", "minLength": 1 },
            "required": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": { "enum": ["text", "number", "boolean", "date", "object", "array"] },
            "required": { "type": "boolean" },
            "default": true
          },
          "additionalProperties": false
        }
      ]
    },
    "trigger": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "config": { "type": "object" }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["$ref"],
      "properties": { "$ref": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "oneOf": [
        {
          "required": ["all"],
          "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/predicate" } } }
        },
        {
          "required": ["any"],
          "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/predicate" } } }
        },
        {
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/predicate" } }
        },
        {
          "required": ["op"],
          "properties": { "op": { "type": "string", "minLength": 1 } }
        }
      ],
      "additionalProperties": true
    },
    "effectCall": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "as": { "type": "string", "minLength": 1 },
        "retry": {
          "type": "object",
          "required": ["max"],
          "properties": {
            "max": { "type": "integer", "minimum": 1 },
            "backoff": { "type": "array", "items": { "type": "number", "minimum": 0 } }
          },
          "additionalProperties": false
        },
        "compensate": { "$ref": "#/$defs/effectCall" }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["predicate"],
      "properties": {
        "predicate": { "$ref": "#/$defs/predicate" },
        "pass": { "$ref": "#/$defs/steps" },
        "fail": { "$ref": "#/$defs/steps" }
      },
      "additionalProperties": false
    },
    "compute": {
      "type": "object",
      "required": ["assign"],
      "properties": { "assign": { "type": "object" } },
      "additionalProperties": false
    },
    "invoke": {
      "type": "object",
      "required": ["workflow"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "as": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "delay": {
      "type": "object",
      "required": ["duration"],
      "properties": { "duration": { "type": ["number", "string"] } },
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "properties": {
        "signal": { "type": "string", "minLength": 1 },
        "timeout": { "type": ["number", "string"] },
        "as": { "type": "string", "minLength": 1 },
        "on_signal": { "$ref": "#/$defs/steps" },
        "on_timeout": { "$ref": "#/$defs/steps" }
      },
      "anyOf": [{ "required": ["signal"] }, { "required": ["timeout"] }],
      "additionalProperties": false
    },
    "foreach": {
      "type": "object",
      "required": ["source", "steps"],
      "properties": {
        "source": { "$ref": "#/$defs/binding" },
        "as": { "type": "string", "minLength": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "on_item_failure": { "enum": ["stop", "continue"] },
        "steps": { "$ref": "#/$defs/steps" }
      },
      "additionalProperties": false
    },
    "repeat": {
      "type": "object",
      "required": ["times", "steps"],
      "properties": {
        "times": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/binding" }] },
        "as": { "type": "string", "minLength": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "on_item_failure": { "enum": ["stop", "continue"] },
        "steps": { "$ref": "#/$defs/steps" }
      },
      "additionalProperties": false
    },
    "parallel": {
      "type": "object",
      "required": ["branches"],
      "properties": {
        "join": { "enum": ["all", "any"] },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["steps"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "steps": { "$ref": "#/$defs/steps" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "gate": { "$ref": "#/$defs/gate" },
        "compute": { "$ref": "#/$defs/compute" },
        "effect": { "$ref": "#/$defs/effect" },
        "invoke": { "$ref": "#/$defs/invoke" },
        "delay": { "$ref": "#/$defs/delay" },
        "wait": { "$ref": "#/$defs/wait" },
        "foreach": { "$ref": "#/$defs/foreach" },
        "repeat": { "$ref": "#/$defs/repeat" },
        "parallel": { "$ref": "#/$defs/parallel" }
      },
      "oneOf": [
        { "required": ["gate"] },
        { "required": ["compute"] },
        { "required": ["effect"] },
        { "required": ["invoke"] },
        { "required": ["delay"] },
        { "required": ["wait"] },
        { "required": ["foreach"] },
        { "required": ["repeat"] },
        { "required": ["parallel"] }
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  }
}
